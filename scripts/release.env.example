# Copy this to scripts/release.env and fill it in. That file is gitignored and
# must stay that way — it holds the signing passwords and a publishing token.
#
#   cp scripts/release.env.example scripts/release.env
#   chmod 600 scripts/release.env
#
# Everything here has an equivalent in GitHub Actions. Where it lives there is
# noted, because when the two disagree the builds differ and nothing says so.

# ── Publishing ──────────────────────────────────────────────────────────────
# The fine-grained token that may write to 17Arigato-jwd/Authno-Releases.
# Same value as the RELEASES_TOKEN secret on Authno-Android. Contents: read
# and write, scoped to that one repository.
RELEASES_TOKEN=

# ── Android signing ─────────────────────────────────────────────────────────
# In CI these are the KEYSTORE_BASE64 / STORE_PASSWORD / KEY_ALIAS /
# KEY_PASSWORD secrets. Here the keystore is a file you already have.
#
# The key MUST be the same one previous releases were signed with. Android
# identifies an app by its signature, so a differently-signed APK cannot
# update an existing install — it fails with "app not installed" and no
# explanation of why.
#
# Leave KEYSTORE_PATH unset to use android/app/keystore.jks.
#KEYSTORE_PATH=/home/you/keys/authno-release.jks
STORE_PASSWORD=
KEY_ALIAS=
KEY_PASSWORD=

# ── Access gate ─────────────────────────────────────────────────────────────
# In CI these are repository *Variables*, not secrets, because Create React
# App inlines every REACT_APP_* into the client bundle — a secret here would
# be a secret published in a JavaScript file. None of them are secret: the
# access key is a public key and the gate is a URL.
#
# Copy the values from Authno-Android → Settings → Secrets and variables →
# Actions → Variables, so a local build and a CI build produce the same app.
#
# REACT_APP_ACCESS_PUBKEY must be the public half of the pair the gate signs
# with. Get it wrong and every key file reads as a bad signature: nobody can
# sign in, and it looks exactly like a wrong password.
REACT_APP_ACCESS_PUBKEY=
REACT_APP_REQUIRE_INVITE=true
REACT_APP_GATE_API=https://authno-gate.bladex01-gaming.workers.dev
