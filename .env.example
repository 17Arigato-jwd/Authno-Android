# AuthNo build configuration — copy to `.env` (git-ignored) or set in CI.
#
# Billing is OFF until BOTH values below are set. With them unset, the Pro page
# keeps the clearly-labelled demo checkout and cannot take money — it never
# pretends an unconfigured build can charge.

# Hosted checkout / payment-link URL. Any gateway works (Razorpay, Stripe,
# Gumroad, LemonSqueezy…) as long as it can email the buyer a licence key.
# Must be https — the desktop app refuses to open anything else.
REACT_APP_CHECKOUT_URL=

# Public half of your licence signing keypair (base64 SPKI, ECDSA P-256).
# Generate with:  node scripts/make-license.js keygen
# The private half stays on your machine and mints keys:
#                 node scripts/make-license.js sign --order ORDER-1234
REACT_APP_LICENSE_PUBKEY=
