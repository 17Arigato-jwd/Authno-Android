# AuthNo build configuration — copy to `.env` (git-ignored) or set in CI.
#
# Billing is OFF until BOTH values below are set. With them unset, the Pro page
# keeps the clearly-labelled demo checkout and cannot take money — it never
# pretends an unconfigured build can charge.

# Hosted checkout / payment-link URL. Any gateway works (Razorpay, Stripe,
# Gumroad, LemonSqueezy…) as long as it can email the buyer a licence key.
# Must be https — the desktop app refuses to open anything else.
REACT_APP_CHECKOUT_URL=

# Public half of your licence signing keypair (base64 SPKI, ECDSA P-256).
# Generate with:  node scripts/make-license.js keygen
# The private half stays on your machine and mints keys:
#                 node scripts/make-license.js sign --order ORDER-1234
REACT_APP_LICENSE_PUBKEY=

# ── Invite gate ─────────────────────────────────────────────────────────────
# AuthNo is invite-only before public release. The website redeems an invite
# code against a pen name and mints a signed ACCESS key; the app verifies it
# offline. This is a SEPARATE keypair from the licence one above, so either can
# rotate without invalidating the other.
#
# Public half (base64 SPKI, ECDSA P-256), printed by the website repo's
#   worker/scripts/make-access-keypair.mjs
REACT_APP_ACCESS_PUBKEY=

# Set to `true` to actually gate the app on startup. With a key present but
# this unset, the build can verify access keys yet still opens normally —
# which is how a beta ships before the invite rollout begins.
REACT_APP_REQUIRE_INVITE=

# The authno-gate Worker's public URL, e.g.
#   https://authno-gate.<account>.workers.dev
#
# Only used at the access gate, and only once: signing in with a pen name and
# password fetches a signed key, which is then verified offline forever after.
# Unset, the gate offers the key-file and paste routes instead — both of which
# need no network at all.
REACT_APP_GATE_API=
