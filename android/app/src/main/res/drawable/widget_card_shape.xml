<?xml version="1.0" encoding="utf-8"?>
<!--
  widget_card_shape.xml — the card silhouette, drawn white so it can be tinted.

  Used as an ImageView src beneath the widget content and recoloured at runtime
  with the active theme's background. That is what lets one drawable serve all
  six themes: the static drawables it replaces could only ever be dark or light,
  which is why Sepia, Paper and OLED all came out looking like plain Dark.

  Radius mirrors RADIUS.xl (20dp) in src/DesignSystem/tokens.js.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#ffffff" />
    <corners android:radius="20dp" />
</shape>
