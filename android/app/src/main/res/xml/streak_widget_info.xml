<?xml version="1.0" encoding="utf-8"?>
<!--
  streak_widget_info.xml
  Metadata that the Android launcher reads to know how to offer and size
  the AuthNo Streak Widget.

  minWidth/minHeight are set to a 3×3-cell default (approx 250×250 dp on
  most launchers).  The widget is freely resizable in both dimensions.
-->
<appwidget-provider
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:minWidth="250dp"
    android:minHeight="250dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="200dp"

    android:updatePeriodMillis="1800000"

    android:initialLayout="@layout/streak_widget"

    android:configure="com.aurorastudios.authno.StreakWidgetConfigActivity"

    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"

    android:previewImage="@mipmap/ic_launcher"

    android:targetCellWidth="4"
    android:targetCellHeight="4"
    android:maxResizeWidth="360dp"
    android:maxResizeHeight="420dp"
    android:previewLayout="@layout/streak_widget"

    android:description="@string/widget_description" />

<!--
  On the newer attributes above:

  previewLayout (API 31+) shows the real widget in the picker. previewImage
  pointed at @mipmap/ic_launcher, so what the picker offered was the app icon
  in a box — it told nobody what they were about to place. previewImage stays
  as the fallback for older launchers, which ignore previewLayout.

  targetCell* (API 31+) asks for a sensible default size in grid cells rather
  than letting the launcher derive one from minWidth. maxResize* stops it being
  stretched to a size the calendar bitmap cannot fill cleanly.

  All four are ignored below API 31, and compileSdk is 34, so they resolve at
  build time on every device.
-->
