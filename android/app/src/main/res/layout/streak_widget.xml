<?xml version="1.0" encoding="utf-8"?>
<!--
  streak_widget.xml
  Home-screen widget layout for the AuthNo Streak Widget.

  All colours reference @color/ds_* from ds_colors.xml, which mirrors
  src/DesignSystem/tokens.js.  Never write colour literals here —
  update ds_colors.xml (and tokens.js) instead.

  Sizes are the design system's scale too, not just the colours:
  TYPOGRAPHY.size for sp, SPACING for dp, RADIUS for corners. There is no
  separate widget ramp — inventing one is how this ended up with 10sp, 10.5sp,
  12sp, 3dp, 5dp, 7dp and a 12dp corner, none of which the app uses anywhere.
  scripts/check-widget-scale.mjs reads tokens.js and fails CI on any value that
  is not on it.
-->
<!--
  The card background is a tintable ImageView rather than a drawable on the
  root. RemoteViews cannot recolour a shape set with setBackgroundResource, so
  the two static drawables this replaces could only ever be dark or light —
  which is why Sepia, Paper, OLED and Material You all rendered as plain Dark.
  An ImageView CAN be tinted at runtime, so one silhouette serves all six.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/widget_card_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_card_shape"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

    <!-- ── Header row: book title + streak number ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <!-- Book icon -->
        <ImageView
            android:id="@+id/widget_book_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_book_gradient"
            android:layout_marginEnd="8dp"
            android:contentDescription="Book" />

        <!-- Title (takes all remaining space) — ds_text_secondary (#dcddde) -->
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AuthNo"
            android:textColor="@color/ds_text_secondary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Streak count (large) — tinted by accent at runtime via StreakWidgetRenderer -->
        <TextView
            android:id="@+id/widget_streak_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/ds_violet_dark"
            android:textSize="28sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="18sp"
            android:autoSizeMaxTextSize="28sp"
            android:autoSizeStepGranularity="1sp" />

        <!-- Flame icon -->
        <ImageView
            android:id="@+id/widget_flame_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_flame_gradient"
            android:layout_marginStart="4dp"
            android:contentDescription="Streak fire" />

    </LinearLayout>

    <!-- ── Meta row: the streak on the left, today's words on the right ──
         One line, not two. Both are ds_text_subtle (#72767d) at size.sm,
         which is the app's caption size. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp"
        android:baselineAligned="false">

        <TextView
            android:id="@+id/widget_streak_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="no streak yet"
            android:textColor="@color/ds_text_subtle"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_progress_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="0 / 300 words today"
            android:textColor="@color/ds_text_subtle"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- ── Today's progress ── -->
    <ProgressBar
        android:id="@+id/widget_progress_bar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/ds_violet_dark"
        android:progressBackgroundTint="@color/ds_progress_track"
        android:layout_marginBottom="12dp" />

    <!-- Start writing — deep-links straight into the editor at the last
         caret position (the app's Resume Writing path). Background drawable
         and text colour are set at runtime per theme/accent. -->
    <TextView
        android:id="@+id/widget_start_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_marginBottom="8dp"
        android:text="Start writing"
        android:textSize="13sp"
        android:textStyle="bold"
        android:background="@drawable/widget_btn_state_dark"
        android:textColor="@color/ds_text_secondary" />

    <!--
      ── Action row ──
      Three compact buttons. Two of them do their work WITHOUT opening the app:
      Next book and Refresh are broadcasts back to StreakWidgetProvider, which
      re-renders in place.

      Text-only on purpose. The one thing this layout already proves works
      inside RemoteViews on the launcher's process is a vector in an ImageView
      src; compound drawables and android:drawableTint are less certain and
      drawableTint needs API 23 against a minSdk of 22. On a surface that
      cannot be tested from here, matching the proven pattern beats a nicer
      button that might render blank on somebody's launcher.

      Colours are set at runtime by StreakWidgetProvider, same as the primary
      button above.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp"
        android:baselineAligned="false">

        <TextView
            android:id="@+id/widget_new_chapter_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="+ Chapter"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:background="@drawable/widget_btn_state_dark"
            android:textColor="@color/ds_text_secondary"
            android:contentDescription="Add a chapter to this book" />

        <TextView
            android:id="@+id/widget_next_book_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="Next book"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:background="@drawable/widget_btn_state_dark"
            android:textColor="@color/ds_text_secondary"
            android:contentDescription="Show the next book on this widget" />

        <TextView
            android:id="@+id/widget_refresh_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="Refresh"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:background="@drawable/widget_btn_state_dark"
            android:textColor="@color/ds_text_secondary"
            android:contentDescription="Reload this widget from the app's saved data" />

    </LinearLayout>

    <!-- ── Calendar bitmap ── -->
    <ImageView
        android:id="@+id/widget_calendar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="fitCenter" />

    </LinearLayout>

</FrameLayout>
