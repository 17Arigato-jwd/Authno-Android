# =========================================
# 🔹 DEPENDENCIES
# =========================================
node_modules/
.pnp/
.pnp.js

# =========================================
# 🔹 TESTING
# =========================================
coverage/

# =========================================
# 🔹 REACT BUILD OUTPUT (NEVER COMMIT)
# =========================================
build/
# Where CI parks the source maps after lifting them out of build/. They are
# the original source in full, so this must never become a tracked directory
# on a repo that is about to go private.
sourcemaps/

# =========================================
# 🔹 ELECTRON BUILD OUTPUT (NEVER COMMIT)
# =========================================
dist/
# electron-builder's output, which is `directories.output` in package.json and
# is NOT `dist/`. Only `dist/` was listed here, so a desktop build left 775 MB
# of unpacked Electron sitting untracked in the working tree — and a routine
# `git add -A` swept it in, including a 251 MB app.asar that GitHub refuses
# outright. The push failed with "remote end hung up", which names neither the
# file nor the reason.
dist-electron/
out/
*.exe
*.AppImage
*.deb
*.rpm
*.dmg

# =========================================
# 🔹 LOGS & TEMP FILES
# =========================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# =========================================
# 🔹 ENVIRONMENT FILES
# =========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# =========================================
# 🔹 OS / EDITOR FILES
# =========================================
.DS_Store
Thumbs.db

# =========================================
# 🔹 VSCODE & IDE SETTINGS
# =========================================
.vscode/
.idea/

# =========================================
# 🔹 ELECTRON CACHE (LARGE FILES)
# =========================================
electron-builder-cache/
.cache/



# =========================================
#              SECRETS
# =========================================
authno-release.jks
*.jks
*.keystore
Authno Extensions.md
# ── Security (3C) ──
keystore.jks
android/app/keystore.jks
google-services.json
android/app/google-services.json
# Build output
android/app/build/
android/app/src/main/assets/public/

# Licence signing private key — minting keys for buyers (NEVER commit)
authno-license-private.json

component-shots/

# Built by scripts/build-sandbox-host.mjs; CI rebuilds it for the installer.
extensions/extbk-sandbox/host/

# The app's own production build must never be dropped in here again.
extensions/extbk-sandbox/app/
